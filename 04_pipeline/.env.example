# Copy to .env and fill in, or export these in your shell.
# Never commit a filled-in .env.

# Required for anything that touches the graph.
NEO4J_PASSWORD=change-me

# Optional overrides (defaults shown).
# NEO4J_URI=bolt://localhost:37689
# NEO4J_USER=neo4j
# OLLAMA_TIMEOUT=60
# OLLAMA_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=30m

# Only needed if your environment requires an authenticated HuggingFace
# download for the fine-tuned Text2Cypher baseline.
# HF_TOKEN=
